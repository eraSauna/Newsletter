# eräSauna newsletter — omgevingsvariabelen. Kopieer naar .env (niet committen).
# Alles op eräSauna-eigen accounts. Geen REPP-keys hergebruiken.

# --- Keys ---
# Google Gemini (lagen 1-3: grounding, filter, lezen).
GOOGLE_API_KEY=
# Anthropic (laag 4: Opus-eindredactie).
ANTHROPIC_API_KEY=

# --- Modellen per laag (env = geen codewijziging nodig) ---
FILTER_MODEL=gemini-3.1-flash-lite     # laag 2: dedup + grove filter (goedkoop)
READER_MODEL=gemini-3.6-flash          # laag 3: lezen, verifiëren, scoren
AUDIT_MODEL=gemini-3.6-flash           # laag 3b: audit afgewezen items
EDITORIAL_MODEL=claude-opus-4-8        # laag 4: eindredactie + conclusies

# --- Kosten & audit ---
MONTHLY_CAP_USD=15                     # harde maandcap (naast Console-spend-limit)
AUDIT_SAMPLE_SIZE=20                   # afgewezen items per editie hergecontroleerd

# --- E-mail (Resend, geverifieerd erasauna.nl-domein) ---
RESEND_API_KEY=
NEWSLETTER_FROM=eräSauna Intelligence <intel@erasauna.nl>
NEWSLETTER_TO=info@erasauna.nl
