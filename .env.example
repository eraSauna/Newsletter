# eräSauna newsletter — omgevingsvariabelen. Kopieer naar .env (niet committen).
# Alles op eräSauna-eigen accounts. Geen REPP-keys hergebruiken.

# Anthropic API (eräSauna-eigen developeraccount, pay-as-you-go).
ANTHROPIC_API_KEY=

# Split-modellen. Lezen goedkoop, eindredactie op Opus.
READING_MODEL=claude-haiku-4-5
EDITORIAL_MODEL=claude-opus-4-8

# Harde maandcap in USD (naast de spend limit in de Anthropic Console).
MONTHLY_CAP_USD=30

# E-mail (Resend, geverifieerd erasauna.nl-domein).
RESEND_API_KEY=
NEWSLETTER_FROM=eräSauna Intelligence <intel@erasauna.nl>
NEWSLETTER_TO=info@erasauna.nl
